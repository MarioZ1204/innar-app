# ==================================
# Configuración de Base de Datos MySQL
# ==================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=TU_PASSWORD_AQUI
DB_NAME=innar_clinica

# ==================================
# Configuración de Servidor
# ==================================
PORT=3000
NODE_ENV=production

# URL del frontend/servidor — usada para CORS
# Ejemplo: http://192.168.1.100:3000 o http://mi-dominio.com
FRONTEND_URL=http://TU_IP_O_DOMINIO:3000

# Secreto para cifrar las sesiones — generar con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=GENERAR_SECRETO_ALEATORIO_AQUI

# ==================================
# Configuración de Seguridad HTTPS
# ==================================
USE_HTTPS=false

# ==================================
# Configuración de Backups
# ==================================
BACKUP_DIR=./backups
MAX_BACKUPS=7
DEBUG_MODE=false
