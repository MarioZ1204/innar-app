# ============================================================
# INNAR APP - Variables de entorno
# Copie este archivo como .env y configure los valores
# NUNCA suba el archivo .env a control de versiones
# ============================================================

# ------------------------------------------------------------
# BASE DE DATOS MySQL
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=innar_clinica

# ------------------------------------------------------------
# SERVIDOR
# ------------------------------------------------------------
PORT=3000
NODE_ENV=development
# NODE_ENV=production   (en producción)

# ------------------------------------------------------------
# SESIONES (REQUERIDO)
# Genere un secreto fuerte, mínimo 32 caracteres aleatorios
# Ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ------------------------------------------------------------
SESSION_SECRET=CAMBIE_ESTO_POR_UN_SECRETO_FUERTE_ALEATORIO

# ------------------------------------------------------------
# CORS / FRONTEND
# ------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
# FRONTEND_URL=https://innarapp.neurocienciasnarino.com   (en producción)

# ------------------------------------------------------------
# COOKIES DE SESIÓN
# En producción con HTTPS: SESSION_COOKIE_SECURE=true
# ------------------------------------------------------------
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# ------------------------------------------------------------
# STORE DE SESIONES
# Por defecto se usa MySQLStore (tabla app_sessions) para que las sesiones
# sobrevivan a reinicios del proceso. Si quiere forzar MemoryStore
# (solo desarrollo, NO recomendado en producción), use:
# SESSION_STORE=memory
# ------------------------------------------------------------
# SESSION_STORE=memory

# ------------------------------------------------------------
# SEGURIDAD CSP (Content Security Policy)
# CSP_ENABLED: activa el middleware Helmet CSP
# CSP_REPORT_ONLY: true = solo reporta, false = bloquea
# CSP_STRICT: true elimina 'unsafe-inline' y 'unsafe-eval' de scriptSrc
#             (solo cuando se hayan migrado los handlers inline — ver docs/FRONTEND-REFACTOR.md)
# ------------------------------------------------------------
CSP_ENABLED=true
CSP_REPORT_ONLY=true
CSP_STRICT=false
# CSP_REPORT_ONLY=false   (cuando CSP esté completamente validado)

# ------------------------------------------------------------
# RATE LIMITING
# API_RATE_LIMIT_MAX: peticiones por IP en 15 min (defecto: 500)
# LOGIN_RATE_LIMIT_MAX: intentos de login por IP en 15 min (defecto: 40)
# RATE_LIMIT_TRUSTED_IPS: IPs de confianza separadas por coma (sin límite)
# ------------------------------------------------------------
API_RATE_LIMIT_MAX=500
LOGIN_RATE_LIMIT_MAX=40
RATE_LIMIT_TRUSTED_IPS=

# ------------------------------------------------------------
# BACKUPS AUTOMÁTICOS
# BACKUP_DIR: ruta absoluta donde se guardan los backups
# MAX_BACKUPS: cantidad máxima de backups a conservar (defecto: 14)
# BACKUP_DAILY_CRON: cron string para backup diario (defecto: 02:00 AM)
# BACKUP_INTRA_CRON: opcional, backups extra (vacío = desactivado)
# ------------------------------------------------------------
BACKUP_DIR=./backups
MAX_BACKUPS=14
BACKUP_DAILY_CRON=0 2 * * *
# BACKUP_INTRA_CRON=0 */6 * * *

# ------------------------------------------------------------
# LOGGING
# LOG_MAX_SIZE_MB: tamaño máximo de archivos de log en MB (defecto: 10)
# DEBUG_MODE: activa logs de depuración adicionales
# LOG_ASYNC: true = write stream + cola asíncrona (recomendado en prod)
# ------------------------------------------------------------
LOG_MAX_SIZE_MB=10
DEBUG_MODE=false
# LOG_ASYNC=true

# ------------------------------------------------------------
# VERSIÓN (opcional, sólo si se desea forzar a los clientes a recargar)
# Si NO se define, el cliente usa el `version` de package.json (estable).
# Defínalo SOLO en deploys reales (ej. con el commit SHA o un timestamp del build).
# NO defina valores variables en runtime: el banner azul "Hay una actualización"
# se dispara cada vez que el servidor reinicia si la versión cambia.
# ------------------------------------------------------------
# APP_BUILD_VERSION=1.3.0
# SOURCE_VERSION=abc1234
