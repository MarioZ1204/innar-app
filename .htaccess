RewriteEngine On

<IfModule mod_proxy.c>
  ProxyPreserveHost On
</IfModule>

# ── Backend Node (mismo valor que PORT en .env — por defecto 3000).
# ── SOCKET_IO_PATH=/api/socket.io en producción suele funcionar mejor que la
#     ruta estándar /socket.io si el proxy del hosting ya atraviesa /api/.
# ── Cuando todo el dominio lo atiende sólo Node (opción Hosting > Node.js App),
#     este archivo no interviene; no hace falta proxy.

RewriteCond %{REQUEST_URI} ^/socket\.io [NC]
RewriteCond %{HTTP:Upgrade} =websocket [NC]
RewriteRule .* ws://127.0.0.1:3000%{REQUEST_URI} [P,L,QSA]

RewriteCond %{REQUEST_URI} ^/socket\.io [NC]
RewriteRule .* http://127.0.0.1:3000%{REQUEST_URI} [P,L,QSA]

RewriteCond %{REQUEST_URI} ^/api/ [NC]
RewriteCond %{HTTP:Upgrade} =websocket [NC]
RewriteRule .* ws://127.0.0.1:3000%{REQUEST_URI} [P,L,QSA]

RewriteCond %{REQUEST_URI} ^/api/ [NC]
RewriteRule .* http://127.0.0.1:3000%{REQUEST_URI} [P,L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/socket\.io [NC]
RewriteCond %{REQUEST_URI} !^/api/ [NC]
RewriteRule ^ public/index.html [QSA,L]
