RewriteEngine On

# ── HTTPS (primero). En algunos paneles HTTPS ya llega cerrado aquí — regla harmless.
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

Options -Indexes

<FilesMatch "^(favicon\.ico|robots\.txt)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Allow from all
    </IfModule>
</FilesMatch>

<FilesMatch "\.(env|git|yml|yaml|log|sh|bat|sql|ini|lock|conf|config)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json
</IfModule>

# ── Proxy a Node.js (sustituir 3000 por el PORT real del panel Hostinger /.env)
<IfModule mod_proxy.c>
  ProxyRequests Off
  ProxyPreserveHost On
</IfModule>

<IfModule mod_ssl.c>
  SSLProxyEngine On
</IfModule>

# 1. Socket.IO PRIMERO — WebSocket cuando el cliente envía Upgrade
RewriteCond %{REQUEST_URI} ^/socket\.io/ [NC]
RewriteCond %{HTTP:Upgrade} websocket [NC]
RewriteCond %{HTTP:Connection} upgrade [NC]
RewriteRule ^(.*)$ ws://127.0.0.1:3000%{REQUEST_URI} [P,L,QSA]

RewriteCond %{REQUEST_URI} ^/socket\.io/ [NC]
RewriteCond %{HTTP:Upgrade} websocket [NC]
RewriteRule ^(.*)$ ws://127.0.0.1:3000%{REQUEST_URI} [P,L,QSA]

# Handshake HTTP / long-polling (misma URl; debe estar justo después de las reglas WS)
RewriteCond %{REQUEST_URI} ^/socket\.io/ [NC]
RewriteRule ^(.*)$ http://127.0.0.1:3000%{REQUEST_URI} [P,L,QSA]

# 2. API REST
RewriteCond %{REQUEST_URI} ^/api/ [NC]
RewriteRule ^(.*)$ http://127.0.0.1:3000%{REQUEST_URI} [P,L,QSA]

# 3. Todo lo demás que NO sea archivo o carpeta física → también Node (Express sirve SPA y rutas).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ http://127.0.0.1:3000%{REQUEST_URI} [P,L,QSA]
