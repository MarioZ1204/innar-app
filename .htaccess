RewriteEngine On

# ── Diagnóstico mod_proxy ───────────────────────────────────────────────
# Las RewriteRule con flag [P] DELEGAN en mod_proxy. Si el servidor no tiene
# mod_proxy (y mod_proxy_http) cargados, Apache/LiteSpeed puede ignorar el
# proxy o responder 500. Este bloque NO "activa" el módulo: sólo ejecuta
# directivas válidas cuando el módulo existe.
# Cómo comprobarlo en Hostinger: soporte técnico, o errores tras desplegar
# (preguntando si están habilitados mod_proxy, proxy_http y proxy_wstunnel).
<IfModule mod_proxy.c>
  ProxyRequests Off
  ProxyPreserveHost On
</IfModule>
# ⚠ Sin mod_proxy cargado, lo siguiente con [P] no tunnelará bien a Node.

# ── HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

Options -Indexes

<FilesMatch "^(favicon\.ico|robots\.txt)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Allow from all
    </IfModule>
</FilesMatch>

<FilesMatch "\.(env|git|yml|yaml|log|sh|bat|sql|ini|lock|conf|config)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json
</IfModule>

<IfModule mod_ssl.c>
  SSLProxyEngine On
</IfModule>

# ── Proxy a Node (este proyecto Hostinger suele usar 7080 — cámbialo si tu panel muestra otro PORT)
# Sintaxis tipo "minimal": /socket.io/ primero, luego /api/, luego no-estático.
# Usar %{REQUEST_URI} + QSA (evita pérdida de ?EIO=&transport=polling con $1 en .htaccess).

RewriteCond %{REQUEST_URI} ^/socket\.io/ [NC]
RewriteCond %{HTTP:Upgrade} websocket [NC]
RewriteCond %{HTTP:Connection} upgrade [NC]
RewriteRule ^(.*)$ ws://127.0.0.1:7080%{REQUEST_URI} [P,L,QSA]

RewriteCond %{REQUEST_URI} ^/socket\.io/ [NC]
RewriteCond %{HTTP:Upgrade} websocket [NC]
RewriteRule ^(.*)$ ws://127.0.0.1:7080%{REQUEST_URI} [P,L,QSA]

RewriteCond %{REQUEST_URI} ^/socket\.io/ [NC]
RewriteRule ^(.*)$ http://127.0.0.1:7080%{REQUEST_URI} [P,L,QSA]

RewriteCond %{REQUEST_URI} ^/api/ [NC]
RewriteRule ^(.*)$ http://127.0.0.1:7080%{REQUEST_URI} [P,L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ http://127.0.0.1:7080%{REQUEST_URI} [P,L,QSA]
