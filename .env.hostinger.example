# ============================================================
# INNAR APP - .env de PRODUCCIÓN (Hostinger)
# Copie como `.env` en la raíz del proyecto y configure
# NUNCA suba `.env` a control de versiones
# ============================================================

# ------------------------------------------------------------
# BASE DE DATOS MySQL (datos provistos por panel Hostinger)
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=u_innar_app
DB_PASSWORD=CAMBIE_POR_PASSWORD_FUERTE
DB_NAME=u_innar_clinica

# ------------------------------------------------------------
# SERVIDOR
# ------------------------------------------------------------
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------
# SESIONES (REQUERIDO — secreto fuerte, 48+ bytes hex)
# Genere con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ------------------------------------------------------------
SESSION_SECRET=GENERAR_CON_CRYPTO_RANDOMBYTES_48_HEX

# Apache termina TLS; el cookie debe ir como Secure
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

# Store persistente en MySQL (tabla app_sessions). NO usar MemoryStore en producción:
# cada reinicio de Node borraría todas las sesiones y los usuarios verían
# el toast "Sesión expirada" inmediatamente después. Dejar SIN definir
# SESSION_STORE = usa MySQLStore automáticamente.
# SESSION_STORE=memory   # NO usar en producción

# ------------------------------------------------------------
# CORS / FRONTEND (mismo dominio servido por Apache + proxy)
# ------------------------------------------------------------
FRONTEND_URL=https://innarapp.neurocienciasnarino.com
# SOCKET_ALLOWED_ORIGINS=https://staging.ejemplo.com

# Por defecto (NODE_ENV=production) Socket.IO monta ya en /api/socket.io.
# Solo descomenta /socket.io si tu proxy entrega ese path al Node como antes:
# SOCKET_IO_PATH=/socket.io

# ------------------------------------------------------------
# CSP (Content Security Policy)
# Iniciar en report-only y observar logs/app.log
# Cuando 0 violaciones en 48h → CSP_REPORT_ONLY=false
# Cuando todos los inline migrados → CSP_STRICT=true
# ------------------------------------------------------------
CSP_ENABLED=true
CSP_REPORT_ONLY=true
CSP_STRICT=false

# ------------------------------------------------------------
# RATE LIMITING
# Whitelist con la IP pública de la sede para evitar bloqueos
# ------------------------------------------------------------
API_RATE_LIMIT_MAX=500
LOGIN_RATE_LIMIT_MAX=40
RATE_LIMIT_TRUSTED_IPS=

# ------------------------------------------------------------
# BACKUPS AUTOMÁTICOS
# BACKUP_DAILY_CRON: cron string para backup diario
# BACKUP_INTRA_CRON: opcional, backups extra (vacío = desactivado)
# MAX_BACKUPS: cantidad máxima a conservar
# ------------------------------------------------------------
BACKUP_DIR=./backups
MAX_BACKUPS=14
BACKUP_DAILY_CRON=0 2 * * *
# BACKUP_INTRA_CRON=0 */6 * * *   (opt-in: cada 6 horas)

# ------------------------------------------------------------
# LOGGING
# LOG_ASYNC=true → escritura con write stream (recomendado en prod)
# DEBUG_MODE=true → muy verboso, NO usar en prod sostenidamente
# ------------------------------------------------------------
LOG_ASYNC=true
LOG_MAX_SIZE_MB=20
DEBUG_MODE=false

# ------------------------------------------------------------
# VERSIÓN (opcional, dejar comentada salvo que se quiera forzar reload tras deploy)
# Por defecto se usa el `version` de package.json (estable entre reinicios).
# Si se define un valor que cambia en cada reinicio, aparecerá el banner azul
# "Hay una actualización disponible" cada vez que se reinicie el servidor.
# Defínalo SÓLO en deploys reales con el SHA del commit o el número de build.
# ------------------------------------------------------------
# APP_BUILD_VERSION=1.3.0
# SOURCE_VERSION=git-sha-corto
