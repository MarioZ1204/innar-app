# ==================================
# Configuración de Base de Datos MySQL
# ==================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD="#1NN4R2026@*/"
DB_NAME=innar_clinica

# ==================================
# Configuración de Servidor
# ==================================
PORT=3000
NODE_ENV=development
SESSION_SECRET=innar-clinica-secret-key-change-in-production
# ==================================
# Configuración de Seguridad HTTPS
# ==================================
# Para desarrollo: USE_HTTPS=false (HTTP simple, más rápido)
# Para producción: generar certificado y USE_HTTPS=true
# Por ahora: HTTP es suficiente
USE_HTTPS=false

# ==================================
# Configuración de Backups
# ==================================
# Carpeta donde se guardan los backups automáticos
BACKUP_DIR=./backups
# Cantidad máxima de backups a mantener
MAX_BACKUPS=7
# Modo debug (set a true para logs detallados)
DEBUG_MODE=false