{
  "name": "innar-app",
  "version": "1.5.84",
  "description": "Innar - Sistema de gestión de agenda médica y recibos",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon -r dotenv/config server.js dotenv_config_path=.env.dev",
    "check:syntax": "node --check server.js",
    "check:hostinger-env": "node scripts/verify-hostinger-env.js",
    "deploy:check": "npm run check:syntax && npm run check:hostinger-env",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "migrate": "node utils/init-db.js && node migrations/db-migrations.js",
    "build": "echo No build step required",
    "build:min": "node scripts/build-minify.js",
    "build:bundle": "node scripts/bundle.js",
    "postinstall": "node scripts/copy-pdfjs.js"
  },
  "keywords": [
    "recibos",
    "facturas",
    "pdf"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.3.2",
    "express-session": "^1.19.0",
    "helmet": "^7.2.0",
    "joi": "^18.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.17.3",
    "node-schedule": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "puppeteer-core": "^24.42.0"
  },
  "devDependencies": {
    "csso-cli": "^4.0.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "pkg": "^5.8.0",
    "sharp": "^0.34.5",
    "terser": "^5.46.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
