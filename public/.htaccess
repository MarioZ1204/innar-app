# Igual que el .htaccess de la raíz, pero SPA → index.html cuando el DocumentRoot
# es sólo esta carpeta. PORT = mismo que .env (3000 típico).
RewriteEngine On

<IfModule mod_proxy.c>
  ProxyPreserveHost On
</IfModule>

RewriteCond %{REQUEST_URI} ^/socket\.io [NC]
RewriteCond %{HTTP:Upgrade} =websocket [NC]
RewriteRule .* ws://127.0.0.1:3000%{REQUEST_URI} [P,L,QSA]

RewriteCond %{REQUEST_URI} ^/socket\.io [NC]
RewriteRule .* http://127.0.0.1:3000%{REQUEST_URI} [P,L,QSA]

RewriteCond %{REQUEST_URI} ^/api/ [NC]
RewriteCond %{HTTP:Upgrade} =websocket [NC]
RewriteRule .* ws://127.0.0.1:3000%{REQUEST_URI} [P,L,QSA]

RewriteCond %{REQUEST_URI} ^/api/ [NC]
RewriteRule .* http://127.0.0.1:3000%{REQUEST_URI} [P,L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/socket\.io [NC]
RewriteCond %{REQUEST_URI} !^/api/
RewriteRule ^ index.html [QSA,L]
